        "P": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "E": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "V": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "X": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "scoring_note": {
          "type": "string",
          "description": "verbatim from data book section 7"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "L",
        "P",
        "E",
        "V",
        "X",
        "total",
        "scoring_note",
        "source"
      ],
      "description": "copied from the v7.1 data book; the validator checks it against data/sources/v7_1/neuresthetics_v7_combined.json"
    },
    "revised_rubric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "not started",
            "draft",
            "reviewed"
          ]
        },
        "L": {
          "$ref": "#/$defs/rubricAxis"
        },
        "P": {
          "$ref": "#/$defs/rubricAxis"
        },
        "E": {
          "$ref": "#/$defs/rubricAxis"
        },
        "V": {
          "$ref": "#/$defs/rubricAxis"
        },
        "X": {
          "$ref": "#/$defs/rubricAxis"
        },
        "revised_by": {
          "type": "string"
        },
        "revised_on": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "L",
        "P",
        "E",
        "V",
        "X"
      ]
    },
    "coding_guidance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "use_when": {
          "type": "string"
        },
        "do_not_use_when": {
          "type": "string"
        },
        "neighbors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relatedCode"
          }
        }
      },
      "required": [
        "use_when",
        "do_not_use_when",
        "neighbors"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data_quality_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "data_quality_flags",
        "open_questions"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "sentinel": {
      "enum": [
        "TODO",
        "UNKNOWN",
        "BELOW_THRESHOLD"
      ],
      "description": "TODO = not researched yet. UNKNOWN = researched, no reliable source gives it (say what was checked in how_known). BELOW_THRESHOLD = some evidence, but under certainty 0.5, so the value is withheld (describe the evidence in note)."
    },
    "certainty": {
      "enum": [
        1.0,
        0.7,
        0.5
      ],
      "description": "See docs/CODING_GUIDE.md. Worldview claims: 1.0 written profession, 0.7 consistent private letters, 0.5 scholarly reconstruction. Other facts: 1.0 established, 0.7 probable, 0.5 contested. Below 0.5: withhold the value (BELOW_THRESHOLD)."
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "locator"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^S[0-9]+$",
          "description": "id of an entry in the sources list"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "description": "page, folio, section, letter number, paragraph, or URL anchor"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "cites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "cites"
      ],
      "properties": {
        "value": {},
        "cites": {
          "$ref": "#/$defs/cites"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "claimRules": {
      "description": "A filled value needs certainty, at least one citation and a how_known note. UNKNOWN / BELOW_THRESHOLD need how_known. TODO needs nothing.",
      "if": {
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "const": "TODO"
          }
        }
      },
      "then": {},
      "else": {
        "if": {
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "enum": [
                "UNKNOWN",
                "BELOW_THRESHOLD"
              ]
            }
          }
        },
        "then": {
          "required": [
            "how_known"
          ],
          "properties": {
            "how_known": {
              "minLength": 1
            }
          }
        },
        "else": {
          "required": [
            "certainty",
            "cites",
            "how_known"
          ],
          "properties": {
            "cites": {
              "minItems": 1
            },
            "how_known": {
              "minLength": 1
            }
          }
        }
      }
    },
    "basis": {
      "enum": [
        "written_profession",
        "consistent_private_letters",
        "scholarly_reconstruction"
      ],
      "description": "Evidence basis for a worldview claim. Must agree with certainty: 1.0 / 0.7 / 0.5."
    },
    "lioScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "description": "PROPOSED 0-4 scale (docs/OPEN_DECISIONS.md): 0 interventionist pole, 2 mixed, 4 LIO pole."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "kind",
        "citation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S[0-9]+$"
        },
        "type": {
          "enum": [
            "primary",
            "secondary",
            "tertiary"
          ]
        },
        "kind": {
          "enum": [
            "letter",
            "diary or notebook",
            "published work by the subject",
            "archive record",
            "scholarly edition",
            "scholarly book",
            "journal article",
            "book chapter",
            "encyclopedia",
            "institutional page",
            "database",
            "other"
          ]
        },
        "citation": {
          "type": "string",
          "minLength": 10,
          "description": "full citation, Chicago author-date or notes style"
        },
        "author": {
          "type": "string"
        },
        "year": {
          "type": [
            "integer",
            "string"
          ]
        },
        "url": {
          "type": "string"
        },
        "archive_url": {
          "type": "string"
        },
        "accessed": {
          "$ref": "#/$defs/isoDate"
        },
        "reliability_note": {
          "type": "string"
        },
        "used_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "changeLogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "by",
        "summary"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/isoDate"
        },
        "by": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "certainty": {
          "$ref": "#/$defs/certainty"
        },
        "cites": {
          "$ref": "#/$defs/cites"
        },
        "how_known": {
          "type": "string",
          "description": "one or two sentences: what kind of evidence, and why this certainty"
        },
        "note": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alternative"
          },
          "description": "competing values from other sources, each cited"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/sentinel"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/claimRules"
        }
      ]
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "certainty": {
          "$ref": "#/$defs/certainty"
        },
        "cites": {
          "$ref": "#/$defs/cites"
        },
        "how_known": {
          "type": "string",
          "description": "one or two sentences: what kind of evidence, and why this certainty"
        },
        "note": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alternative"
          },
          "description": "competing values from other sources, each cited"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/sentinel"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/claimRules"
        }
      ]
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "certainty": {
          "$ref": "#/$defs/certainty"
        },
        "cites": {
          "$ref": "#/$defs/cites"
        },
        "how_known": {
          "type": "string",
          "description": "one or two sentences: what kind of evidence, and why this certainty"
        },
        "note": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alternative"
          },
          "description": "competing values from other sources, each cited"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/sentinel"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "year": {
          "type": [
            "integer",
            "string"
          ]
        },
        "author": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/claimRules"
        }
      ]
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "certainty": {
          "$ref": "#/$defs/certainty"
        },
        "cites": {
          "$ref": "#/$defs/cites"
        },
        "how_known": {
          "type": "string",
          "description": "one or two sentences: what kind of evidence, and why this certainty"
        },
        "note": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alternative"
          },
          "description": "competing values from other sources, each cited"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/sentinel"
            },
            {
              "$ref": "#/$defs/lioScore"
            }
          ]
        },
        "rationale": {
          "type": "string",
          "description": "justification in terms of the axis poles, for the system's official or scholarly form"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/claimRules"
        }
      ]
    },
    "rubricAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "rationale"
      ],
      "properties": {
        "score": {
          "anyOf": [
            {
              "$ref": "#/$defs/sentinel"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            }
          ]
        },
        "rationale": {
          "type": "string"
        },
        "cites": {
          "$ref": "#/$defs/cites"
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "form",
        "how_it_differs"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$",
          "description": "if this variant has its own code among the 77"
        },
        "form": {
          "enum": [
            "scholastic or philosophical",
            "popular",
            "mystical",
            "reform",
            "modern",
            "regional",
            "other"
          ]
        },
        "how_it_differs": {
          "type": "string"
        },
        "lio_difference": {
          "type": "string",
          "description": "which LIO axes move, and which way"
        },
        "certainty": {
          "$ref": "#/$defs/certainty"
        },
        "cites": {
          "$ref": "#/$defs/cites"
        }
      }
    },
    "relatedCode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "relation"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "relation": {
          "enum": [
            "parent tradition",
            "offshoot",
            "scholastic form of",
            "popular form of",
            "neighbor (easily confused)",
            "contrast case",
            "overlaps"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
