{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neuresthetics/neuresthetics_genius_study/schema/system.schema.json",
  "title": "Neuresthetics Genius Study belief-system record (YAML front matter of systems/<CODE>.md)",
  "description": "Field meanings: docs/DATA_DICTIONARY.md (Part 3). Coding rules: docs/CODING_GUIDE.md (Part 2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record",
    "identity",
    "classification",
    "origins",
    "metaphysics",
    "lio_axes",
    "epistemology",
    "ethics",
    "practice",
    "science",
    "schools_and_variants",
    "adherents",
    "v7_1_rubric",
    "revised_rubric",
    "coding_guidance",
    "review",
    "sources"
  ],
  "properties": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "record_version",
        "review_status",
        "collected_by",
        "model_used",
        "collected_on",
        "last_updated",
        "change_log"
      ],
      "properties": {
        "record_type": {
          "const": "system"
        },
        "schema_version": {
          "const": "1.0"
        },
        "record_version": {
          "type": "integer",
          "minimum": 1
        },
        "review_status": {
          "enum": [
            "stub",
            "example — unreviewed",
            "draft — unreviewed",
            "in review",
            "reviewed",
            "needs revision"
          ]
        },
        "collected_by": {
          "type": "string",
          "description": "who ran the collection (person or agent)"
        },
        "model_used": {
          "type": "string",
          "description": "model and version used, or 'none (human)'"
        },
        "collected_on": {
          "$ref": "#/$defs/isoDate"
        },
        "last_updated": {
          "$ref": "#/$defs/isoDate"
        },
        "reviewed_by": {
          "type": "string"
        },
        "reviewed_on": {
          "$ref": "#/$defs/isoDate"
        },
        "change_log": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/changeLogEntry"
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "v7_1_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 77
        },
        "v7_1_label": {
          "type": "string",
          "description": "system name exactly as in data book section 7 (or table 4 if section 7 has none)"
        },
        "display_label": {
          "type": "string",
          "description": "label used in v8 tables"
        },
        "label_status": {
          "enum": [
            "as in v7.1",
            "proposed — pending Jason's OK",
            "approved"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "v7_1_number",
        "v7_1_label",
        "display_label",
        "label_status",
        "aliases"
      ]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "certainty": {
              "$ref": "#/$defs/certainty"
            },
            "cites": {
              "$ref": "#/$defs/cites"
            },
            "how_known": {
              "type": "string",
              "description": "one or two sentences: what kind of evidence, and why this certainty"
            },
            "note": {
              "type": "string"
            },
            "alternatives": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/alternative"
              },
              "description": "competing values from other sources, each cited"
            },
            "value": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sentinel"
                },
                {
                  "enum": [
                    "religion",
                    "philosophical school or method",
                    "metaphysical thesis",
                    "ethical or civic movement",
                    "epistemic stance",
                    "esoteric or occult tradition",
                    "new religious movement",
                    "indigenous or traditional religion",
                    "reconstructionist religion",
                    "family of positions"
                  ]
                }
              ]
            }
          },
          "allOf": [
            {
              "$ref": "#/$defs/claimRules"
            }
          ]
        },
        "family": {
          "$ref": "#/$defs/text"
        },
        "parent_traditions": {
          "$ref": "#/$defs/list"
        },
        "related_codes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relatedCode"
          }
        }
      },
      "required": [
        "kind",
        "family",
        "parent_traditions",
        "related_codes"
      ]
    },
    "origins": {
      "type": "object",
      "additionalProperties": false,
